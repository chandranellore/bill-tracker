pose":"","la":{}},{"num":"SAMDT 6875","type":"SAMDT","number":"6875","desc":"","purpose":"","la":{}},{"num":"SAMDT 6874","type":"SAMDT","number":"6874","desc":"","purpose":"","la":{}},{"num":"SAMDT 6873","type":"SAMDT","number":"6873","desc":"","purpose":"","la":{}},{"num":"SAMDT 6872","type":"SAMDT","number":"6872","desc":"","purpose":"","la":{}},{"num":"SAMDT 6871","type":"SAMDT","number":"6871","desc":"","purpose":"","la":{}},{"num":"SAMDT 6870","type":"SAMDT","number":"6870","desc":"","purpose":"","la":{}},{"num":"SAMDT 6869","type":"SAMDT","number":"6869","desc":"","purpose":"","la":{}},{"num":"SAMDT 6868","type":"SAMDT","number":"6868","desc":"","purpose":"","la":{}},{"num":"SAMDT 6867","type":"SAMDT","number":"6867","desc":"","purpose":"","la":{}},{"num":"SAMDT 6866","type":"SAMDT","number":"6866","desc":"","purpose":"","la":{}},{"num":"SAMDT 6865","type":"SAMDT","number":"6865","desc":"","purpose":"","la":{}},{"num":"SAMDT 6864","type":"SAMDT","number":"6864","desc":"","purpose":"","la":{}},{"num":"SAMDT 6863","type":"SAMDT","number":"6863","desc":"","purpose":"","la":{}},{"num":"SAMDT 6862","type":"SAMDT","number":"6862","desc":"","purpose":"","la":{}},{"num":"SAMDT 6861","type":"SAMDT","number":"6861","desc":"","purpose":"","la":{}},{"num":"SAMDT 6860","type":"SAMDT","number":"6860","desc":"","purpose":"","la":{}},{"num":"SAMDT 6859","type":"SAMDT","number":"6859","desc":"","purpose":"","la":{}},{"num":"SAMDT 6858","type":"SAMDT","number":"6858","desc":"","purpose":"","la":{}},{"num":"SAMDT 6857","type":"SAMDT","number":"6857","desc":"","purpose":"","la":{}},{"num":"SAMDT 6856","type":"SAMDT","number":"6856","desc":"","purpose":"","la":{}},{"num":"SAMDT 6855","type":"SAMDT","number":"6855","desc":"","purpose":"","la":{}},{"num":"SAMDT 6854","type":"SAMDT","number":"6854","desc":"","purpose":"","la":{}},{"num":"SAMDT 6853","type":"SAMDT","number":"6853","desc":"","purpose":"","la":{}},{"num":"SAMDT 6852","type":"SAMDT","number":"6852","desc":"","purpose":"","la":{}},{"num":"SAMDT 6851","type":"SAMDT","number":"6851","desc":"","purpose":"","la":{}},{"num":"SAMDT 6850","type":"SAMDT","number":"6850","desc":"","purpose":"","la":{}},{"num":"SAMDT 6849","type":"SAMDT","number":"6849","desc":"","purpose":"","la":{}}],"summaries":[{"v":"Reported to House","d":"2026-04-09","html":"<p><strong>Survivor Justice Tax Prevention Act</strong></p><p>This bill excludes from gross income certain damages received by an individual due to any sexual act or sexual contact and establishes the applicable burden of proof in court proceedings regarding the characterization of such damages for federal tax purposes. </p><p>Under current law, amounts received as damages (other than punitive damages) from a judgment, award, or settlement of a claim may be excluded from gross income and, thus, are not subject to federal income tax, if attributable to a personal physical injury or physical sickness. The Internal Revenue Service (IRS) generally interprets <em>personal physical injury</em> to require observable bodily harm (e.g., bruising, cuts, swelling, or bleeding).</p><p>Under the bill, amounts received as damages (other than punitive damages) from a judgment, award, or settlement due to any sexual act or sexual conduct, whether or not there are medical records or observable injuries of such act or contact, may be excluded from gross income.</p><p>Further, if a judgment, award, or settlement states that damages are due to any sexual act or sexual conduct, then the IRS has the burden of proving otherwise in court proceedings related to the tax liability associated with such damages. </p><p>Finally, the bill requires the IRS to promote public awareness of the exclusion from gross income of damages related to any sexual act or sexual contact.</p>"}],"versions":[{"type":"Introduced in House","date":"2025-03-25","code":"ih","htm":"https://www.congress.gov/119/bills/hr2347/BILLS-119hr2347ih.htm","pdf":"https://www.congress.gov/119/bills/hr2347/BILLS-119hr2347ih.pdf"},{"type":"Reported in House","date":"2026-04-09","code":"rh","htm":"https://www.congress.gov/119/bills/hr2347/BILLS-119hr2347rh.htm","pdf":"https://www.congress.gov/119/bills/hr2347/BILLS-119hr2347rh.pdf"},{"type":"Engrossed in House","date":"2026-04-27","code":"eh","htm":"https://www.congress.gov/119/bills/hr2347/BILLS-119hr2347eh.htm","pdf":"https://www.congress.gov/119/bills/hr2347/BILLS-119hr2347eh.pdf"},{"type":"Placed on Calendar Senate","date":"2026-07-14","code":"pcs","htm":"https://www.congress.gov/119/bills/hr2347/BILLS-119hr2347pcs.htm","pdf":"https://www.congress.gov/119/bills/hr2347/BILLS-119hr2347pcs.pdf"}],"cbo":[{"title":"H.R. 2347, Survivor Justice Tax Prevention Act","date":"2026-04-24","url":"https://www.cbo.gov/publication/62383","desc":"As reported by the House Committee on Ways and Means on April 9, 2026"}],"reports":[{"citation":"H. Rept. 119-599"}],"laws":[],"related":[],"updated":"2026-11-12"}