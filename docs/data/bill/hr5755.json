{"id":"hr5755","type":"HR","number":"5755","congress":119,"title":"No Budget, No Pay Act","introduced":"2025-10-14","chamber":"House","policy":"Congress","sponsor":[{"id":"P000608","name":"Rep. Peters, Scott H. [D-CA-50]","party":"D","state":"CA"}],"cosponsors":8,"la":{"actionDate":"2025-10-14","text":"Referred to the House Committee on House Administration."},"topics":["budget"],"stage":1,"actions":[{"d":"2025-10-14","t":"Referred to the House Committee on House Administration.","k":"IntroReferral","c":"H"},{"d":"2025-10-14","t":"Introduced in House","k":"IntroReferral","c":""}],"committees":[{"name":"Committee on House Administration","chamber":"House","code":"hsha00","acts":[{"d":"2025-10-14","n":"Referred To"}],"subs":[]}],"amendments":[],"summaries":[{"v":"Introduced in House","d":"2025-10-14","html":"<p><strong>No Budget, No Pay Act</strong></p><p>This bill prohibits Members of Congress from being paid in a fiscal year until both chambers approve the budget resolution and pass all regular appropriations bills for that fiscal year. Retroactive pay is prohibited for such a period. </p>"}],"versions":[{"type":"Introduced in House","date":"2025-10-14","code":"ih","htm":"https://www.congress.gov/119/bills/hr5755/BILLS-119hr5755ih.htm","pdf":"https://www.congress.gov/119/bills/hr5755/BILLS-119hr5755ih.pdf","local":"data/text/hr5755/ih.txt","size":5860}],"cbo":[],"reports":[],"laws":[],"related":[],"updated":"2026-09-19"}